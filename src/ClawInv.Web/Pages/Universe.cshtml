@page
@model ClawInv.Web.Pages.UniverseModel
@{
    ViewData["Title"] = "Universe settings";
}

<h1>Universe settings</h1>

<form method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Rating limit</label>
        <input class="form-control" asp-for="Input.RatingLimit" />
        <div class="form-text">Include funds with rating ≤ this value.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Total fee limit (%)</label>
        <input class="form-control" asp-for="Input.TotalFeeLimit" />
        <div class="form-text">Include funds with total fee ≤ this limit.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Risk limit (0 = no cap)</label>
        <input class="form-control" asp-for="Input.RiskLimit" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <button type="submit" class="btn btn-outline-secondary" asp-page-handler="Regenerate">Regenerate universe now</button>
</form>

<hr />

<div class="mt-3">
    <div><strong>Last regenerated:</strong> @Model.LastRegeneratedText</div>
    <div><strong>Fund count:</strong> @Model.UniverseFundCount</div>
</div>
