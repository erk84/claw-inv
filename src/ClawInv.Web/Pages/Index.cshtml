@page
@model ClawInv.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Portföljer";
}

<h1>Portföljer</h1>

@if (Model.Cards.Count == 0)
{
    <p>Inga strategier är aktiva. Gå till <a asp-page="/Strategies">Strategier</a> och aktivera minst en.</p>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model.Cards)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="h5 mb-0">@c.DisplayName</div>
                                <div class="text-muted"><small>@c.Kind • @c.Slots slots</small></div>
                            </div>
                            <div>
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Strategy" asp-route-id="@c.StrategyId">Öppna</a>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div class="text-muted"><small>Simulerat saldo</small></div>
                            <div class="h4 mb-0">@c.SimulatedBalance.ToString("0") kr</div>
                            <div class="text-muted"><small>Start 100 000 kr</small></div>
                        </div>

                        <div class="mt-3 d-flex justify-content-between">
                            <div>
                                <div class="text-muted"><small>Aktiva innehav</small></div>
                                <div class="fw-semibold">@c.ActiveHoldingsCount</div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted"><small>Snitt (aktiva)</small></div>
                                <div class="fw-semibold">@(c.ActiveHoldingsPerfAvgPct is null ? "-" : $"{c.ActiveHoldingsPerfAvgPct:0.##}%")</div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div class="text-muted"><small>Senaste rekommendation</small></div>
                            <div class="fw-semibold">@(c.LatestAsOf?.ToString() ?? "-")</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
